{
  "manifest_version": 3,
  "name": "Ecom Insight v3.5.4",
  "version": "3.5.4",
  "description": "Flipkart seller analytics with controller-owned trusted certification, transactional restoration and run-scoped diagnostics.",
  "permissions": ["storage", "downloads", "tabs", "activeTab"],
  "host_permissions": ["https://seller.flipkart.com/*", "https://*.seller.flipkart.com/*"],
  "action": {
    "default_title": "Ecom Insight",
    "default_icon": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}
  },
  "background": {"service_worker":"background.js"},
  "content_scripts": [
    {"matches":["https://seller.flipkart.com/*","https://*.seller.flipkart.com/*"],"js":["page-bridge.js"],"run_at":"document_start","world":"MAIN"},
    {"matches":["https://seller.flipkart.com/*","https://*.seller.flipkart.com/*"],"js":["v346-context-guard.js","v341-pagination-guard.js","content.js","v343-sync-controller.js","v348-runtime-diagnostics.js"],"css":["content.css"],"run_at":"document_start"}
  ],
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "web_accessible_resources": [{
    "resources": ["dashboard.html","styles.css","app.js","icons/*","page-bridge.js","v34-core.js","v341-migration-integrity.js","v341-clear-modes.js","v341-backup-schema.js","v341-inventory-parser.js","v341-data-coverage.js","v341-seller-identity.js","v341-orders-parser.js","v341-returns-parser.js","v341-payments-parser.js","v341-settlements-parser.js","v341-xlsx-importer.js","v345-runtime.js","v354-dashboard-certification.js"],
    "matches": ["https://seller.flipkart.com/*","https://*.seller.flipkart.com/*"]
  }]
}
